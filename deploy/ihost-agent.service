[Unit]
Description=iHost Node Agent
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/ihost
EnvironmentFile=/opt/ihost/.env.agent
ExecStart=/usr/bin/node /opt/ihost/dist/agent.js
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
